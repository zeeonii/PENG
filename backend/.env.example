# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 .gitignore 로 막혀 있다.
#   cp .env.example .env
#
# application.yml 은 이 이름들을 그대로 환경변수로 읽는다. 코드에 값을 넣지 말 것.

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/sixpeng?characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# --- Google OAuth2 ---
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs (Web application)
# 승인된 리디렉션 URI 에 반드시 아래 주소를 등록해야 한다:
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 로그인 후 돌아갈 프론트 주소 ---
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:5173/auth/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:5173/login?error=oauth

# --- CORS 허용 오리진 (쉼표 구분) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://peng-527.pages.dev

# --- 테스트용 DB (gradlew test) ---
TEST_DB_URL=jdbc:mysql://localhost:3306/sixpeng_test?characterEncoding=UTF-8&serverTimezone=UTC
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=
