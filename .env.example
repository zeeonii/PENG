# docker compose 용 환경변수 예시. 이 파일을 `.env` 로 복사해서 값을 채운다.
#
#   cp .env.example .env
#
# 이 파일 하나가 두 가지로 쓰인다.
#   1. docker-compose.yml 안의 ${...} 치환 (mysql 서비스 비밀번호, 빌드 인자)
#   2. backend 컨테이너의 env_file (스프링 설정값)
# 그래서 MySQL 변수와 백엔드 변수를 한 파일에 같이 둔다.
#
# `.env` 는 .gitignore 로 막혀 있다. 실제 값이 든 파일은 절대 커밋하지 않는다.
# 백엔드를 도커 없이 로컬에서 직접 띄울 때는 backend/.env.example 을 참고한다.


# ── MySQL 컨테이너 ────────────────────────────────────────────────────────────
# docker-compose.yml 의 mysql 서비스가 기동할 때 쓴다.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=sixpeng


# ── 백엔드 → DB 접속 ──────────────────────────────────────────────────────────
# 호스트명은 반드시 compose 서비스명인 `mysql` 이다. 컨테이너 안에서 localhost 는
# 자기 자신을 가리키므로 접속에 실패한다.
# 포트도 컨테이너 내부 포트인 3306 이다. compose 의 "3307:3306" 은 호스트에서
# 들여다볼 때 쓰는 매핑이라 컨테이너끼리 통신할 때는 상관없다.
DB_URL=jdbc:mysql://mysql:3306/sixpeng?characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# 스키마 반영 전략. update = 엔티티 변경분을 자동 반영, validate = 검증만.
DDL_AUTO=update


# ── ChromaDB ─────────────────────────────────────────────────────────────────
# 여기도 compose 서비스명을 쓴다.
CHROMA_BASE_URL=http://chromadb:8000


# ── Google 로그인 (OAuth2) ───────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# 승인된 리디렉션 URI 에 아래 두 개가 등록돼 있어야 한다.
#   https://morrow.p-e.kr/login/oauth2/code/google   (배포)
#   http://localhost:8080/login/oauth2/code/google   (로컬)
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me


# ── 프론트엔드 연동 ──────────────────────────────────────────────────────────
# 기본값이 전부 localhost:5173 이라, 배포 서버에서 안 채우면 로그인 성공 후
# localhost 로 리다이렉트되어 실패한다.
FRONTEND_URL=https://peng-527.pages.dev
OAUTH2_SUCCESS_REDIRECT_URI=https://peng-527.pages.dev/auth/callback
OAUTH2_FAILURE_REDIRECT_URI=https://peng-527.pages.dev/login?error=oauth

# 세션 쿠키를 교차 사이트로 주고받아야 하므로 프론트 오리진이 정확히 들어가야 한다.
CORS_ALLOWED_ORIGINS=https://peng-527.pages.dev,http://localhost:5173


# ── 외부 API ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://morrow.p-e.kr/integrations/notion/callback

GOOGLE_MEET_REDIRECT_URI=https://morrow.p-e.kr/integrations/google-meet/callback


# ── 배포 정보 (선택) ─────────────────────────────────────────────────────────
# 이미지에 박혀 /actuator/info 의 deployment.commit / deployment.branch 로 나온다.
# 여기에 적어두는 대신 배포할 때 셸에서 넘기는 쪽을 권장한다.
#   GIT_COMMIT=$(git rev-parse --short HEAD) \
#   GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD) \
#   docker compose up -d --build
# GIT_COMMIT=
# GIT_BRANCH=
